{
	"name": "natsuyasumi-board-frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite build && vite preview",
		"start": "node build",
		"dev:lite": "NYB_TARGET=lite vite dev",
		"build:lite": "NYB_TARGET=lite NYB_BASE=/natsuyasumi-board vite build",
		"preview:lite": "NYB_TARGET=lite NYB_BASE=/natsuyasumi-board vite build && NYB_TARGET=lite NYB_BASE=/natsuyasumi-board vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:lite": "NYB_TARGET=lite svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test --conditions browser"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "^20.11.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.69.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.2",
		"@testing-library/svelte": "^5.4.2",
		"@types/bun": "^1.3.14",
		"@types/node": "^24.13.3",
		"bun-plugin-svelte": "^0.0.6",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.2",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"vite": "^8.1.4"
	},
	"dependencies": {
		"@lucide/svelte": "^1.24.0"
	}
}
